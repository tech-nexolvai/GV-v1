# Copy to .env and fill. NEVER commit .env or real secrets.

# Databases (one PostgreSQL server, two logical DBs)
DATABASE_URL=postgresql://gv:CHANGE_ME@localhost:5432/gv_app
HATCHET_DATABASE_URL=postgresql://gv:CHANGE_ME@localhost:5432/hatchet

# Object storage
AWS_REGION=us-east-1
S3_BUCKET=gv-v1-artifacts

# Bedrock (VLM — ambiguous crops only). NOTE: the verdict service must NOT receive these.
BEDROCK_MODEL_ID=amazon.nova-2-lite

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
