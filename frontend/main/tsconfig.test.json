{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "skipLibCheck": true,
    "strict": true,
    "outDir": "./node_modules/.tmp/chat-render-test",
    "rootDir": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "src/api/schema.d.ts",
    "src/data/types.ts",
    "src/api/sse.ts",
    "src/components/settings/CompanySettingsList.tsx",
    "src/components/settings/companySettings.ts",
    "src/components/upload/ProductTypeField.tsx",
    "src/components/ui/outcome-badge.tsx"
  ],
  "exclude": [
    "tests/vitest/**"
  ],
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  }
}
