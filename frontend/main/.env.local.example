# Copy to .env.local. Vite only exposes variables prefixed VITE_.

# Which project this client asks about. Required — `src/api/config.ts` refuses rather than
# defaulting, because a made-up project id would 404 against a boundary behaving correctly and read
# as a broken API. Use a real project UUID from your database:
#
#   psql "$GV_DATABASE_URL" -c 'select id, name from projects;'
VITE_PROJECT_ID=

# Where the API is, if not the default. The dev server proxies /api to 127.0.0.1:8000, so this is
# normally unnecessary.
# VITE_API_TARGET=http://127.0.0.1:8000
