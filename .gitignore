# --- Proprietary client inputs — NEVER commit ---
# Anchored with a leading slash on purpose. Unanchored, `data/` matches a directory of that name
# ANYWHERE in the tree, and it silently swallowed `frontend/main/src/data/` — the frontend's mock
# data and its type definitions — so eight modules on `frontend-init-dev` import a file that was
# never committed and the app cannot build. The rule still has to catch the real thing, which is the
# client's drawings at the repository root; `tests/test_repo_hygiene.py` asserts both halves by
# asking git rather than by reading this file.
/data/
eval/gold_set/cases/
*.dwg
# Client spreadsheets belong in data/, which is ignored above. This catches the case
# where one is dropped somewhere tracked instead — docs/ is committed, and a checklist
# landing there was how three of them reached a remote branch once.
*.xlsx
*.xls

# --- Secrets ---
.env
*.pem
*.key
# The engine client token `make token` writes. It is a bearer credential for the whole tenant, and it
# lands in the working tree by design so the runbook can tell you to copy it — which makes ignoring it
# the difference between a convenience and a committed secret.
.hatchet-token

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# --- Node / frontend ---
node_modules/
frontend/dist/

# --- OS / editor / agent ---
.DS_Store
.idea/
.vscode/
# Explicit rather than incidental: this file holds per-machine tool settings.
.claude/settings.local.json

# Subagent worktrees. Live git repos; never part of this one.
.claude/worktrees/
